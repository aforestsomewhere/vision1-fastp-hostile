#!/usr/bin/env bash
#SBATCH --job-name=clean
#SBATCH --cpus-per-task=10
#SBATCH --output=logs/clean_%A_%a.out
#SBATCH --error=logs/clean_%A_%a.err

set -euo pipefail
module load apptainer

# -------------------------------------------------------------------------
# Arguments
# -------------------------------------------------------------------------

samples_tsv="$1"
outdir="$2"
ENV_FILE="$3"
CLEAN_SCRIPT="$4"

# -------------------------------------------------------------------------
# Validate inputs
# -------------------------------------------------------------------------

[[ -f "$samples_tsv" ]] || {
    echo "ERROR: samples TSV not found: $samples_tsv" >&2
    exit 1
}

[[ -f "$ENV_FILE" ]] || {
    echo "ERROR: config file not found: $ENV_FILE" >&2
    exit 1
}

[[ -f "$CLEAN_SCRIPT" ]] || {
    echo "ERROR: clean-one-sample script not found: $CLEAN_SCRIPT" >&2
    exit 1
}

# Load configuration (defines $IMAGE)
source "$ENV_FILE"

[[ -n "${IMAGE:-}" ]] || {
    echo "ERROR: IMAGE is not defined in $ENV_FILE" >&2
    exit 1
}

[[ -f "$IMAGE" ]] || {
    echo "ERROR: Apptainer image not found: $IMAGE" >&2
    exit 1
}

mkdir -p "$outdir"

echo "Samples TSV: $samples_tsv"
echo "Output:      $outdir"
echo "Config:      $ENV_FILE"
echo "Container:   $IMAGE"
echo "Script:      $CLEAN_SCRIPT"

# -------------------------------------------------------------------------
# Get this array task's row
#
# samples.tsv:
#   line 1 = header
#   line 2 = array task 1
#   line 3 = array task 2
#   ...
# -------------------------------------------------------------------------

line_num=$((SLURM_ARRAY_TASK_ID + 1))

IFS=$'\t' read -r sample r1 r2 < <(
    sed -n "${line_num}p" "$samples_tsv"
)

if [[ -z "${sample:-}" || -z "${r1:-}" || -z "${r2:-}" ]]; then
    echo "ERROR: Could not read sample for array task $SLURM_ARRAY_TASK_ID" >&2
    exit 1
fi

[[ -f "$r1" ]] || {
    echo "ERROR: R1 not found: $r1" >&2
    exit 1
}

[[ -f "$r2" ]] || {
    echo "ERROR: R2 not found: $r2" >&2
    exit 1
}

echo
echo "Array task: $SLURM_ARRAY_TASK_ID"
echo "Sample:     $sample"
echo "R1:         $r1"
echo "R2:         $r2"
echo "Node:       $(hostname)"
echo "Start:      $(date)"
echo

# -------------------------------------------------------------------------
# Run clean-one-sample INSIDE the Apptainer container
# -------------------------------------------------------------------------

apptainer exec "$IMAGE" \
    --bind /data:/data \
    bash "$CLEAN_SCRIPT" \
    --r1 "$r1" \
    --r2 "$r2" \
    --sample "$sample" \
    --outdir "$outdir/$sample" \
    --threads "$SLURM_CPUS_PER_TASK" \
    --hostile-index /data/databases_food/bowtie_indices/a_thaliana \
    --hostile-index-label arabidopsis \
    --hostile-index /data/databases_food/bowtie_indices/m_domestica \
    --hostile-index-label apple

echo
echo "Finished: $sample"
echo "End:      $(date)"
