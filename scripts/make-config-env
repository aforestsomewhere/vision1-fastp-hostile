#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage:
  make-config-env [OUTPUT_ENV]

Creates a config file for the fastp + hostile SLURM workflow.

Defaults:
  OUTPUT_ENV = config/my_run.env

It populates paths using the current working directory:
  IMAGE       = $PWD/fastp-hostile.sif
  SAMPLES_TSV = $PWD/samples.tsv
  OUTDIR      = $PWD/cleaned_reads

Example:
  scripts/make-config-env
  scripts/make-config-env config/test.env
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

output_env="${1:-config/my_run.env}"
cwd="$(pwd)"

mkdir -p "$(dirname "$output_env")"

cat > "$output_env" <<EOF
# Auto-generated by scripts/make-config-env
# Generated from working directory:
#   $cwd

# Built Apptainer image
IMAGE=$cwd/fastp-hostile.sif

# Sample sheet: tab-separated with header:
# sample    r1    r2
SAMPLES_TSV=$cwd/samples.tsv

# Main output directory
OUTDIR=$cwd/cleaned_reads

# Directories to bind into the container.
# Include every top-level path that contains inputs, outputs, or indices.
APPTAINER_BINDS="/data:/data"

# Hostile / Bowtie2 index prefixes.
# These are prefixes, not .1.bt2 files.
# Example:
#   /data/databases_food/bowtie_indices/a_thaliana.1.bt2
# Prefix:
#   /data/databases_food/bowtie_indices/a_thaliana
HOSTILE_INDICES=(
  /data/databases_food/bowtie_indices/a_thaliana
  /data/databases_food/bowtie_indices/b_oleracea
  /data/databases_food/bowtie_indices/b_taurus
  /data/databases_food/bowtie_indices/c_arietinum
  /data/databases_food/bowtie_indices/capra_hircus
  /data/databases_food/bowtie_indices/h_vulgare
  /data/databases_food/bowtie_indices/human-t2t-hla.argos-bacteria-985_rs-viral-202401_ml-phage-202401
  /data/databases_food/bowtie_indices/human_T2T-CHM13v2.0.1
  /data/databases_food/bowtie_indices/m_domestica
  /data/databases_food/bowtie_indices/ovis_aries
  /data/databases_food/bowtie_indices/phiX174
)

# Labels for output folders. Must match HOSTILE_INDICES order.
HOSTILE_INDEX_LABELS=(
  a_thaliana
  b_oleracea
  b_taurus
  c_arietinum
  capra_hircus
  h_vulgare
  human-t2t-hla.argos-bacteria-985_rs-viral-202401_ml-phage-202401
  human_T2T-CHM13v2.0.1
  m_domestica
  ovis_aries
  phiX174
)

# Threads per sample. In SLURM array mode this should match --cpus-per-task.
THREADS_PER_SAMPLE=10
EOF

echo "Wrote $output_env"
echo
echo "Please check/edit:"
echo "  HOSTILE_INDICES"
echo "  HOSTILE_INDEX_LABELS"
echo "  THREADS_PER_SAMPLE"
echo
echo "Current values:"
echo "  IMAGE=$cwd/fastp-hostile.sif"
echo "  SAMPLES_TSV=$cwd/samples.tsv"
echo "  OUTDIR=$cwd/cleaned_reads"
